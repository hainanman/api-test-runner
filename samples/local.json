{
  "info": {
    "_postman_id": "11111111-1111-1111-1111-111111111111",
    "name": "示例一：本地演示接口",
    "description": "本项目自带的本地 Mock 服务，不依赖外网，最稳定。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8765" }
  ],
  "item": [
    {
      "name": "获取文章列表",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
      }
    },
    {
      "name": "获取单篇文章",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/posts/1", "host": ["{{baseUrl}}"], "path": ["posts", "1"] }
      }
    },
    {
      "name": "按用户过滤文章",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/posts?userId=2", "host": ["{{baseUrl}}"], "path": ["posts"] }
      }
    },
    {
      "name": "查询某文章的评论",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/posts/1/comments", "host": ["{{baseUrl}}"], "path": ["posts", "1", "comments"] }
      }
    },
    {
      "name": "创建一篇文章",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"测试标题\",\"body\":\"测试内容\",\"userId\":1}"
        },
        "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
      }
    }
  ]
}
