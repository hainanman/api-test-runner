{
  "info": {
    "_postman_id": "22222222-2222-2222-2222-222222222222",
    "name": "示例二：JSONPlaceholder（公开练习接口）",
    "description": "一个专门供学习测试使用的假数据接口，无需登录、无频次限制。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" }
  ],
  "item": [
    {
      "name": "获取全部文章",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
      }
    },
    {
      "name": "获取单篇文章",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/posts/1", "host": ["{{baseUrl}}"], "path": ["posts", "1"] }
      }
    },
    {
      "name": "获取用户列表",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      }
    },
    {
      "name": "按文章查评论",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/comments?postId=1", "host": ["{{baseUrl}}"], "path": ["comments"] }
      }
    }
  ]
}
